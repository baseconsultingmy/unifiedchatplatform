{
	email {$ACME_EMAIL:admin@baseapp.asia}
	key_type rsa2048
	# Prefer ZeroSSL RSA → Sectigo R46 (more widely trusted than ECC/E46).
	cert_issuer acme {
		dir https://acme.zerossl.com/v2/DV90
		email {$ACME_EMAIL:admin@baseapp.asia}
		eab {$ZEROSSL_EAB_KID} {$ZEROSSL_EAB_HMAC_KEY}
	}
	# Disable HTTP/3 — some Chrome builds mishandle Alt-Svc/QUIC during CA migrations.
	servers {
		protocols h1 h2
	}
}

baseapp.asia, www.baseapp.asia {
	respond "BaseApp Unified — gateway online. Admin: https://admin.baseapp.asia" 200
}

api.baseapp.asia {
	reverse_proxy api:8000 {
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 2s
		health_uri /health
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

admin.baseapp.asia {
	header {
		# Stop browsers sticking to broken HTTP/3 from earlier deploys
		-Alt-Svc
	}
	reverse_proxy admin:80 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

:80 {
	respond "BaseApp Unified — gateway online" 200
}
