{
	email admin@baseapp.asia
	key_type rsa2048
	# Classic LE profile + RSA → YR*/X1 chain, more widely trusted than YE* ECDSA.
	cert_issuer acme {
		dir https://acme-v02.api.letsencrypt.org/directory
		email admin@baseapp.asia
		profile classic
		preferred_chains {
			root_common_name "ISRG Root X1"
		}
	}
}

baseapp.asia, www.baseapp.asia {
	respond "BaseApp Unified — gateway online. Admin: https://admin.baseapp.asia" 200
}

api.baseapp.asia {
	reverse_proxy api:8000 {
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 2s
		health_uri /health
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

admin.baseapp.asia {
	reverse_proxy admin:80 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

:80 {
	respond "BaseApp Unified — gateway online" 200
}
