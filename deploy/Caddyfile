{
	email {$ACME_EMAIL:admin@baseapp.asia}
	# ZeroSSL — widely trusted in Chrome/Safari. Let's Encrypt Gen Y (YE/YR)
	# was triggering NET::ERR_CERT_AUTHORITY_INVALID for some browsers.
	cert_issuer acme {
		dir https://acme.zerossl.com/v2/DV90
		email {$ACME_EMAIL:admin@baseapp.asia}
		eab {$ZEROSSL_EAB_KID} {$ZEROSSL_EAB_HMAC_KEY}
	}
}

baseapp.asia, www.baseapp.asia {
	respond "BaseApp Unified — gateway online. Admin: https://admin.baseapp.asia" 200
}

api.baseapp.asia {
	reverse_proxy api:8000 {
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 2s
		health_uri /health
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

admin.baseapp.asia {
	reverse_proxy admin:80 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

:80 {
	respond "BaseApp Unified — gateway online" 200
}
