	respond "BaseApp Unified — gateway online. Admin: https://admin.baseapp.asia" 200
}

api.baseapp.asia {
	reverse_proxy api:8000 {
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 2s
		health_uri /health
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}

admin.baseapp.asia {
	header {
		-Alt-Svc
	}
	reverse_proxy admin:80 {
		lb_try_duration 5s
		lb_try_interval 250ms
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}

:80 {
	respond "BaseApp Unified — gateway online" 200
}
