{
	email admin@baseapp.asia
}

# Marketing landings. Add nation hosts here after DNS A records exist
# (my/sg/id/th/ph/vn.baseapp.asia) so ACME can issue certs.
# Until then, preview regions with ?region=my on the apex.
baseapp.asia, www.baseapp.asia {
	root * /srv/landing
	encode gzip
	try_files {path} /index.html
	file_server
}

api.baseapp.asia {
	reverse_proxy api:8000
}

admin.baseapp.asia {
	reverse_proxy admin:80
}

:80 {
	redir https://baseapp.asia{uri} permanent
}
