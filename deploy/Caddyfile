# Marketing / nation landings — region pill from hostname (see landing/app.js)
baseapp.asia, www.baseapp.asia,
my.baseapp.asia, sg.baseapp.asia, id.baseapp.asia,
th.baseapp.asia, ph.baseapp.asia, vn.baseapp.asia {
	root * /srv/landing
	encode gzip
	try_files {path} /index.html
	file_server
}

api.baseapp.asia {
	reverse_proxy api:8000
}

admin.baseapp.asia {
	reverse_proxy admin:80
}

:80 {
	redir https://baseapp.asia{uri} permanent
}
