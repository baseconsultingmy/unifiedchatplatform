POSTGRES_DB=baseapp
POSTGRES_USER=baseapp
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-with-long-random-string
BOOTSTRAP_ADMIN_EMAIL=admin@baseapp.asia
BOOTSTRAP_ADMIN_PASSWORD=replace-me
BOOTSTRAP_TENANT_NAME=BaseApp Demo Studio
CORS_ORIGINS=https://admin.baseapp.asia
VITE_API_BASE=https://api.baseapp.asia
WA_VERIFY_TOKEN=baseapp-wa-verify
WA_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
PUBLIC_API_BASE=https://api.baseapp.asia
PAYMENT_MODE=demo
# Google Identity Services — merchant social login / self-serve signup
# Create an OAuth Web client in Google Cloud; authorized JS origin: https://admin.baseapp.asia
GOOGLE_CLIENT_ID=
PUBLIC_ADMIN_BASE=https://admin.baseapp.asia
# ZeroSSL ACME (preferred for Chrome-trusted certs). Generate with:
#   curl -sS -X POST https://api.zerossl.com/acme/eab-credentials-email -d "email=YOUR@EMAIL"
ACME_EMAIL=admin@baseapp.asia
ZEROSSL_EAB_KID=
ZEROSSL_EAB_HMAC_KEY=
# Grab Food POS partner (https://developer.grab.com — GrabFood API v1.1.3)
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_PARTNER_WEBHOOK_SECRET=
# LINE Messaging API credentials are per-shop (Settings → LINE), not platform env.
# Cloudflare (Master Admin → Edge) — Zone DNS Edit + Zone Settings Edit
# https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
CF_ZONE=baseapp.asia
ORIGIN_IP=157.245.149.238
# Exabytes WHMCS API (optional) — nameserver changes from Master Admin
# Create at billing.exabytes.my → Account → API Credentials (or ask Exabytes support)
EXABYTES_API_URL=https://billing.exabytes.my/mypanel
EXABYTES_API_IDENTIFIER=
EXABYTES_API_SECRET=
EXABYTES_PORTAL_URL=https://billing.exabytes.my/mypanel
# WhatsApp Flows (in-chat booking) — generate with openssl, store PEM or base64
WA_FLOW_PRIVATE_KEY=
WA_FLOW_PRIVATE_KEY_PASSWORD=
WA_FLOW_PUBLIC_KEY=
WA_FLOW_DRAFT_MODE=false
WA_FLOW_ENABLED=true
